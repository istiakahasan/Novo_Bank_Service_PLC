<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings used inside the Docker build stage.
  The services in this repository build the shared security-starter from source, so no credentials are needed.
  If a service depends on com.banking:shared-security-starter published to GitHub Packages, pass
    docker compose build --build-arg GH_PACKAGES_USER=<login> --build-arg GH_PACKAGES_TOKEN=<token with read:packages>
  (or export both variables before `docker compose up --build`) and add the repository to that service's pom.xml.
  Maven expands ${env.*} from the build stage environment; empty values are harmless.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <servers>
    <server>
      <id>github</id>
      <username>${env.GH_PACKAGES_USER}</username>
      <password>${env.GH_PACKAGES_TOKEN}</password>
    </server>
  </servers>
</settings>
