# Local development settings for docker-compose.yml.
# scripts/make-key.sh copies this file to .env.local (git-ignored) and fills in JWT_PRIVATE_KEY / JWT_PUBLIC_KEY.
# Nothing here points at a cloud service.

# --- PostgreSQL (container "postgres", database "banking")
SUPABASE_HOST=postgres
SUPABASE_DB_USER=banking
SUPABASE_DB_PASSWORD=localdev
# the services hard-code the database name "postgres" in application.yml; this overrides the whole URL
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/banking

# --- Redis (no password, no TLS)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# --- QStash stand-in (WireMock)
QSTASH_TOPIC_URL=http://wiremock:8080/qstash/topic
QSTASH_TOKEN=localdev-token
QSTASH_CURRENT_SIGNING_KEY=local-current-key
QSTASH_NEXT_SIGNING_KEY=local-next-key
# WireMock cannot compute QStash's HMAC signature, so the webhook signature check is switched off locally only
QSTASH_VERIFY_SIGNATURES=false

# --- Mailhog (SMTP :1025, UI http://localhost:8025)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@novobank.local

# --- JWT (RS256). make-key.sh writes a fresh key pair here.
#     PRIVATE: base64 of the PEM file.  PUBLIC: base64 of the DER (the form every service can parse).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=banking-auth

# --- service URLs inside the compose network
AUTH_URL=http://auth:3008
CUSTOMER_SERVICE_URL=http://customer:3003
LEDGER_SERVICE_URL=http://ledger:3004
SUPPORT_SERVICE_URL=http://support:3007

# --- browsers (the Next.js apps run on the host)
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3200

# overridden per service in docker-compose.yml
PORT=3003
