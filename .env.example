# Copy to .env (never commit .env)
SUPABASE_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your-db-password
QSTASH_TOPIC_URL=https://qstash.upstash.io/v2/publish/https://YOUR-RENDER-URL/events
QSTASH_TOKEN=
PORT=3003
REDIS_HOST=xxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true

# --- fraud-service (3005) / notification-service (3006) ---
# Required by fraud/notification. On the main app it is OPTIONAL: set it only if Customer and Ledger are deployed separately (HTTP KYC lookup).
CUSTOMER_SERVICE_URL=https://novo-bank-service-plc.onrender.com
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_VERIFY_SIGNATURES=true
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@novobank.test

# --- authorization (see docs/AUTHORIZATION.md; generate with scripts/gen-keys.sh) ---
JWT_PRIVATE_KEY=            # auth-service only
JWT_PUBLIC_KEY=             # main app
JWT_REVOCATION_FAIL_OPEN=false
SYSTEM_KEYS=ledger=KEY_L;fraud-service=KEY_F;notification-service=KEY_N   # main app (inbound service keys)
SERVICE_ID=                 # fraud-service / notification-service (outbound identity)
SERVICE_KEY=
AUTH_BOOTSTRAP_PASSWORD=    # auth-service first run: creates user "staff"
AUTH_BOOTSTRAP_DEMO=false   # true = also demo users alice / bob
