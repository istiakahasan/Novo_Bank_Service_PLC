{
  "name": "QStash topic: fan-out of every other event to all four webhook endpoints",
  "priority": 10,
  "request": {
    "method": "POST",
    "url": "/qstash/topic"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "messageId": "msg_local_event", "deduplicated": false }
  },
  "serveEventListeners": [
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://fraud:3005/webhooks/transfer-completed",
        "headers": { "Content-Type": "application/json", "Upstash-Message-Id": "msg_local_event" },
        "body": "{{{originalRequest.body}}}"
      }
    },
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://fraud:3005/webhooks/customer-created",
        "headers": { "Content-Type": "application/json", "Upstash-Message-Id": "msg_local_event" },
        "body": "{{{originalRequest.body}}}"
      }
    },
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://notification:3006/webhooks/transfer-completed",
        "headers": { "Content-Type": "application/json", "Upstash-Message-Id": "msg_local_event" },
        "body": "{{{originalRequest.body}}}"
      }
    },
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://notification:3006/webhooks/customer-created",
        "headers": { "Content-Type": "application/json", "Upstash-Message-Id": "msg_local_event" },
        "body": "{{{originalRequest.body}}}"
      }
    }
  ]
}
