{
  "name": "QStash topic: transfer.completed -> fraud, notification, support",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/qstash/topic",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.event", "equalTo": "transfer.completed" } }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "messageId": "msg_local_transfer", "deduplicated": false }
  },
  "serveEventListeners": [
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://fraud:3005/webhooks/transfer-completed",
        "headers": { "Content-Type": "application/json", "Upstash-Message-Id": "msg_local_transfer" },
        "body": "{{{originalRequest.body}}}"
      }
    },
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://notification:3006/webhooks/transfer-completed",
        "headers": { "Content-Type": "application/json", "Upstash-Message-Id": "msg_local_transfer" },
        "body": "{{{originalRequest.body}}}"
      }
    },
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://support:3007/webhooks/transfer-completed",
        "headers": { "Content-Type": "application/json", "Upstash-Message-Id": "msg_local_transfer" },
        "body": "{{{originalRequest.body}}}"
      }
    }
  ]
}
