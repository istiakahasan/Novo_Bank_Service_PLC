# Copy to .env.local for development; set the same names in the Vercel project settings.
NEXT_PUBLIC_CUSTOMER_SERVICE_URL=https://customer-service.onrender.com
NEXT_PUBLIC_LEDGER_SERVICE_URL=https://ledger-service.onrender.com
NEXT_PUBLIC_SUPPORT_SERVICE_URL=https://support-service.onrender.com
NEXT_PUBLIC_AUTH_URL=https://auth-service.onrender.com
# at least 32 random characters, e.g.  openssl rand -base64 32
SESSION_SECRET=
# optional overrides (defaults match auth-service in this repo)
# AUTH_LOGIN_PATH=/auth/login
# AUTH_REFRESH_PATH=/auth/refresh
# AUTH_LOGOUT_PATH=/auth/logout
